# Snippt — Vorlage für lokale Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# `.env.local` selbst gehört NICHT ins Git (siehe .gitignore).

# --- Supabase (Pflicht) ---
# Aus dem Supabase-Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key: NUR serverseitig (API-Routen) verwenden, niemals an den Browser geben.
# Wird ab SG3/SG4 für kundenseitige Schreibzugriffe (Anstellen, Soft-Account) gebraucht,
# damit die Datenbank-Sicherheitsregeln nicht durch offene Policies aufgeweicht werden müssen.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMS-Anbieter für den „du bist dran"-Ping (ab SG5; Anbieter noch zu entscheiden) ---
# Beispiel Twilio — erst ausfüllen, wenn der Anbieter feststeht:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
